# TradingViewのアラートメッセージ内 "secret" と一致させる(長いランダム文字列にする)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# paper = 模擬売買のみ。live は実ブローカー実装後に使う(今は paper 固定で動く)
TRADING_MODE=paper

# リスク制限
MAX_NOTIONAL_PER_ORDER=66.7     # 1注文の上限(USD)。未設定なら元手の全額
MAX_ORDERS_PER_DAY=20           # 1日の注文回数の上限
MAX_DAILY_LOSS=6.7              # 1日の確定損失(USD)がこれを超えたら当日停止。未設定なら元手の10%
KILL_SWITCH=false               # true にすると全注文を拒否

# 売買を許可するマーケット(カンマ区切り)
ENABLED_MARKETS=crypto,fx,us_stock,jp_stock

# 模擬売買の記録先
JOURNAL_PATH=data/journal.jsonl

# 戦略ランナー(TradingViewなしで、無料の価格データから自前で売買シグナルを出す)
RUNNER_ENABLED=false             # true で有効化(Fly.ioでは Secrets に RUNNER_ENABLED=true)
CAPITAL_JPY=10000                # 模擬の元手(円)。銘柄×戦略に均等配分する(例: 4銘柄×3戦略=1ボット約833円)
# 売買対象: market:provider:銘柄コード[:通貨] をカンマ区切り。通貨を省略するとUSD。
#  provider は kraken(暗号資産) か yahoo(FX/株/先物)。FX は USDJPY=X、日本株は 7203.T、先物は ES=F の形式
RUNNER_INSTRUMENTS=fx:yahoo:USDJPY=X:JPY,fx:yahoo:EURJPY=X:JPY,fx:yahoo:AUDJPY=X:JPY,us_stock:yahoo:SPY
RUNNER_INTERVAL_MIN=1440         # 足の長さ(分)。1440=日足(既定)。60=1時間足(手数料負けしやすいので非推奨)
RUNNER_ORDER_NOTIONAL=0          # 0なら元手から自動計算。数字を入れると1ボットあたりの配分額(USD)を固定
JPY_PER_USD=150                  # 円建て銘柄を米ドルに直す概算レート(上限判定・成績・円換算用)

# スマホ通知(ntfy.sh)。アプリで同じトピック名を購読する。トピック名は推測されにくい長い文字列にする(パスワード代わり)
NTFY_TOPIC=

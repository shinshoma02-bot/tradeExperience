# TradingViewのアラートメッセージ内 "secret" と一致させる(長いランダム文字列にする)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# paper = 模擬売買のみ。live は実ブローカー実装後に使う(今は paper 固定で動く)
TRADING_MODE=paper

# リスク制限
MAX_NOTIONAL_PER_ORDER=1000     # 1注文の上限金額(price*qty)
MAX_ORDERS_PER_DAY=20           # 1日の注文回数の上限
MAX_DAILY_LOSS=200              # 1日の確定損失がこれを超えたら当日停止
KILL_SWITCH=false               # true にすると全注文を拒否

# 売買を許可するマーケット(カンマ区切り)
ENABLED_MARKETS=crypto,fx,us_stock,jp_stock,futures

# 模擬売買の記録先
JOURNAL_PATH=data/journal.jsonl

# 戦略ランナー(TradingViewなしで、無料の価格データから自前で売買シグナルを出す)
RUNNER_ENABLED=false             # true で有効化(Fly.ioでは fly.toml で有効)
# 売買対象: market:provider:銘柄コード[:通貨] をカンマ区切り。通貨を省略するとUSD。
#  provider は kraken(暗号資産) か yahoo(FX/株/先物)。FX は USDJPY=X、日本株は 7203.T、先物は ES=F の形式
RUNNER_INSTRUMENTS=crypto:kraken:XBTUSD,crypto:kraken:ETHUSD,fx:yahoo:USDJPY=X:JPY,fx:yahoo:EURUSD=X,us_stock:yahoo:AAPL,us_stock:yahoo:NVDA,jp_stock:yahoo:7203.T:JPY,futures:yahoo:ES=F
JPY_PER_USD=150                  # 円建て銘柄を米ドルに直す概算レート(上限判定と成績の換算用)
RUNNER_INTERVAL_MIN=60           # 足の長さ(分): 1,5,15,30,60,240,1440
RUNNER_ORDER_NOTIONAL=100        # 1注文の金額(USD換算。円建て銘柄は JPY_PER_USD で円に直して使う)

# スマホ通知(ntfy.sh)。アプリで同じトピック名を購読する。トピック名は推測されにくい長い文字列にする(パスワード代わり)
NTFY_TOPIC=
